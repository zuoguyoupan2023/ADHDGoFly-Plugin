{
  "name": "adhdgofly-plugin-analytics",
  "version": "1.0.0",
  "description": "ADHDGoFly 插件分析服务 - Cloudflare Workers",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "db:create": "wrangler d1 create adhdgofly_plugin_analytics",
    "db:init": "wrangler d1 execute adhdgofly_plugin_analytics --file=schema.sql",
    "db:query": "wrangler d1 execute adhdgofly_plugin_analytics --command",
    "db:backup": "wrangler d1 export adhdgofly_plugin_analytics --output=backup.sql"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "analytics",
    "plugin-tracking"
  ],
  "author": "ADHDGoFly Team",
  "license": "MIT",
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}