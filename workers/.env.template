# ADHDGoFly Plugin Workers 环境变量配置模板
# 复制此文件为 .env 并填入实际值

# =============================================================================
# Cloudflare Workers 配置
# =============================================================================

# Cloudflare API Token (用于部署)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# Cloudflare Account ID
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# =============================================================================
# Download Tracker Worker 配置
# =============================================================================

# Download Tracker Worker URL (用于下载统计)
DOWNLOAD_TRACKER_WORKER_URL=https://your-download-tracker.workers.dev

# Download Tracker Worker 认证令牌 (可选)
DOWNLOAD_TRACKER_AUTH_TOKEN=your_download_tracker_auth_token

# Download Tracker D1 数据库 ID
DOWNLOAD_TRACKER_DB_ID=your_download_tracker_db_id

# =============================================================================
# Plugin Analytics Worker 配置
# =============================================================================

# Plugin Analytics Worker URL (用于插件埋点)
PLUGIN_ANALYTICS_WORKER_URL=https://your-plugin-analytics.workers.dev

# Plugin Analytics Worker 认证令牌 (可选)
PLUGIN_ANALYTICS_AUTH_TOKEN=your_plugin_analytics_auth_token

# Plugin Analytics D1 数据库 ID
PLUGIN_ANALYTICS_DB_ID=your_plugin_analytics_db_id

# =============================================================================
# Vercel 环境变量配置 (需要在 Vercel Dashboard 中设置)
# =============================================================================

# 下载统计 API (collect.js) 使用
# DOWNLOAD_TRACKER_WORKER_URL=https://your-download-tracker.workers.dev/api/track-download
# CLOUDFLARE_WORKER_URL=https://your-download-tracker.workers.dev/api/track-download  # 向后兼容

# 插件埋点 API (plugin-analytics.js) 使用
# PLUGIN_ANALYTICS_WORKER_URL=https://your-plugin-analytics.workers.dev

# Worker 认证令牌 (可选)
# WORKER_AUTH_TOKEN=your_worker_auth_token

# GitHub 备份配置 (可选)
# ENABLE_GITHUB_BACKUP=true
# GITHUB_TOKEN=your_github_token

# =============================================================================
# 部署配置说明
# =============================================================================

# 1. Download Tracker Worker 处理:
#    - 插件下载统计 (/api/track-download)
#    - 下载数据查询 (/api/stats, /api/stats/public)
#    - 健康检查 (/health)

# 2. Plugin Analytics Worker 处理:
#    - 插件生命周期事件 (/api/plugin-events)
#    - 插件使用统计查询 (/api/stats, /api/stats/public)
#    - 健康检查 (/health)

# 3. Vercel API 层:
#    - collect.js -> Download Tracker Worker
#    - plugin-analytics.js -> Plugin Analytics Worker

# =============================================================================
# 部署步骤
# =============================================================================

# 1. 配置环境变量:
#    cp .env.template .env
#    # 编辑 .env 文件，填入实际值

# 2. 部署 Workers:
#    ./deploy-all.sh

# 3. 配置 Vercel 环境变量:
#    在 Vercel Dashboard 中设置上述环境变量

# 4. 测试部署:
#    ./test-all.sh

# =============================================================================
# 故障排除
# =============================================================================

# 如果部署失败，请检查:
# 1. Cloudflare API Token 权限
# 2. D1 数据库是否已创建
# 3. wrangler.toml 配置是否正确
# 4. 网络连接是否正常