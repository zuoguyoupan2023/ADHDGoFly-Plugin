{
  "manifest_version": 3,
  "name": "__MSG_appName__",
  "version": "0.1.3",
  "description": "__MSG_appDescription__",
  "default_locale": "en",
  "permissions": ["activeTab", "storage", "management"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
        "content/dictionary-manager-new.js",
        "content/dictionary-adapter.js",
        "content/language-detector.js",
        "content/en-noun-morphology.js",
        "content/text-segmenter.js",
        "content/page-processor.js",
        "content/streaming-page-processor.js",
        "content/main.js"
      ],
    "css": ["styles.css"],
    "run_at": "document_end"
  }],
  "action": {
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [{
    "resources": ["dictionaries/*.json"],
    "matches": ["<all_urls>"]
  }]
}