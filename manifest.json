{
  "manifest_version": 3,
  "name": "ADHDGoFly, highlight your sight",
  "version": "0.1.5",
  "description": "Text highlighting for better reading",
  "permissions": ["activeTab", "storage", "management", "alarms", "tabs"],
  "host_permissions": ["https://api.github.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": [
        "content/file-list-generator.js",
        "content/dictionary-manager-new.js",
        "content/dictionary-adapter.js",
        "content/language-detector.js",
        "content/en-noun-morphology.js",
        "content/vocabulary-counter.js",
        "content/text-segmenter.js",
        "content/page-processor.js",
        "content/streaming-page-processor.js",
        "content/storage/event-cache-manager.js",
        "content/storage/adhdgofly-counter.js",
        "content/storage/review-timer.js",
        "content/storage/adhdgofly-timer.js",
        "content/storage/review-counter.js",
        "review-light-tower.js",
        "content/main.js"
      ],
    "css": ["styles.css"],
    "run_at": "document_end"
  }],
  "icons": {
    "16": "public/logo-300x300.png",
    "32": "public/logo-300x300.png",
    "48": "public/logo-300x300.png",
    "128": "public/logo-300x300.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "public/logo-300x300.png",
      "32": "public/logo-300x300.png",
      "48": "public/logo-300x300.png",
      "128": "public/logo-300x300.png"
    }
  },
  "web_accessible_resources": [{
    "resources": [
      "dictionaries/*.json",
      "dictionaries/ZH/*.json",
      "dictionaries/EN/*.json",
      "dictionaries/FR/*.json",
      "dictionaries/ES/*.json",
      "dictionaries/RU/*.json",
      "dictionaries/JA/*.json",
      "locales/*.json"
    ],
    "matches": ["<all_urls>"]
  }]
}